
<div class="directory-container">
  <h2 class="directory-title">Faculty Directory</h2>



  <div class="directory-layout">
    <!-- Left Sidebar -->
    <aside class="sidebar">
      <div class="filter-group">
        <label for="search-input">Search Faculty</label>
        <input
          id="search-input"
          type="search"
          placeholder="First name, last name, or title"
          [value]="searchTerm"
          (input)="updateSearchTerm($event)" />
      </div>

      <div class="filter-group">
        <label for="division-select">Division</label>
       
      </div>
    </aside>

    <!-- Main Table Area -->
    <div class="table-wrapper">
      <div class="table-wrapper">
        <table class="faculty-table">

          <thead>
            <tr style="background-color: #f2f2f2;">
              <th>Last Name</th>
              <th>First Name</th>
              <th>Title</th>
              <th>Division</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let member of filteredFacultyMembers">
              <td class="member-name">{{ member.name }}</td>
              <td class="member-name">{{ member.fname }}</td>
              <td class="member-name">{{ member.title }}</td>
              <td><span class="badge">{{ member.department }}</span></td>
              <td>
                <a class="action-link" [routerLink]="['/faculty', member.id]">View Publications ({{ member.publications.length }})</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>


